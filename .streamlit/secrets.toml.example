# Copy to .streamlit/secrets.toml (gitignored) and fill in the keys you have.
# On Streamlit Community Cloud, paste this content into App settings → Secrets.
#
# Nothing here is required to start the app. Each key switches on the part of
# the pipeline that needs it; without it that part degrades and says so:
#
#   PIONEER_API_KEY  — the planning agent. Missing: "Build my publishing plan"
#                      reports the failure instead of returning a plan.
#   TERAC_API_KEY    — real human work. Missing: the sidebar's "Post to Terac
#                      for real" toggle falls back to the simulated stub.
#   STRIPE_*         — the invoice checkout. Missing: the invoice renders but
#                      the pay button is replaced by a setup note.

PIONEER_API_KEY = "pio_sk_"
TERAC_API_KEY = ""

# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY = "sk_"
STRIPE_PUBLISHABLE_KEY = "pk_"
